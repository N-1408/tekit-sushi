# Tekit Sushi Mini App — barcha o'zgaruvchilar ro'yxati (haqiqiy qiymat YO'Q, faqat joy tutuvchi)
# Vercel'da: Settings → Environment Variables. Lokal: bu faylni .env ga nusxalang.

# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgres://user:parol@host:5432/dbname   # Postgres ulanish satrlari (majburiy)
DATABASE_SSL=no-verify        # no-verify (standart, hozirgi holat) | verify | off
DATABASE_SSL_CA=              # DATABASE_SSL=verify bo'lsa sertifikat (PEM matni); ixtiyoriy
PGPOOL_MAX=3                  # bir jarayondagi maksimal DB ulanishi (serverless uchun kichik)

# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF      # BotFather'dan olingan bot tokeni
TELEGRAM_WEBHOOK_SECRET=      # webhook'ni tekshirish uchun maxsus so'z (o'rnatilishi SHART)
WEBAPP_URL=https://tekit-sushi-miniapp.vercel.app/   # mini ilova manzili
WEBAPP_ORIGIN=https://tekit-sushi-miniapp.vercel.app # CORS uchun ruxsat etilgan manba
APP_ORIGIN=                   # webhook callback URL'lari uchun asos (bo'sh bo'lsa WEBAPP_URL)

# --- Admin ---
ADMIN_PASSWORD=               # admin panel paroli (xavfsiz, uzun)

# --- Yetkazib berish ---
DELIVERY_PROVIDER=own         # own | millennium | noor
DELIVERY_FEE=15000            # standart yetkazib berish narxi (so'm)
DELIVERY_FREE_THRESHOLD=200000 # bundan yuqori buyurtmaga bepul yetkazish
DELIVERY_WEBHOOK_SECRET=      # yetkazib berish webhook'i siri
MILLENNIUM_API_URL=           # shartnoma bo'lsa: Millennium API manzili
MILLENNIUM_TOKEN=             # Millennium API tokeni
NOOR_API_URL=                 # shartnoma bo'lsa: Noor API manzili
NOOR_TOKEN=                   # Noor API tokeni

# --- To'lov ---
PAYMENT_PROVIDER=manual       # manual | rhmt | payme
PAYMENT_WEBHOOK_SECRET=       # to'lov webhook'i siri
RHMT_API_URL=                 # Rahmat PAY API manzili (shartnoma bo'lsa)
RHMT_TOKEN=                   # Rahmat PAY tokeni
RHMT_STORE_ID=                # Rahmat PAY do'kon ID'si

# --- SMS (hozircha Telegram xabari ishlatiladi, SMS zaxira) ---
SMS_PROVIDER=mock             # mock | eskiz
ESKIZ_EMAIL=                  # Eskiz.uz kabineti emaili
ESKIZ_PASSWORD=               # Eskiz.uz paroli

# --- Frontend (Vite, build vaqtda) ---
VITE_API_URL=                 # bo'sh = xuddi shu manzildan (/api/...); VPSda to'liq URL beriladi

# --- Server rejimi (miniapp/server) ---
PORT=3000                     # oddiy serverda eshitiladigan port
