{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/telegram/webhook",
      "destination": "/api/telegram"
    },
    {
      "source": "/api/webhook/delivery",
      "destination": "/api/webhook?type=delivery"
    },
    {
      "source": "/api/webhook/payment",
      "destination": "/api/webhook?type=payment"
    },
    {
      "source": "/api/delivery-quote",
      "destination": "/api/branches?type=quote"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
