# Tekit Sushi bot — barcha o'zgaruvchilar (haqiqiy qiymat YO'Q)
BOT_TOKEN=123456:ABC-DEF      # BotFather'dan olingan bot tokeni (majburiy)
WEBAPP_URL=https://tekit-sushi-miniapp.vercel.app/   # mini ilova manzili (tugma uchun)
ADMIN_CHAT_ID=                # yangi buyurtma keladigan chat ID'si (ixtiyoriy)
DATABASE_URL=postgres://user:parol@host:5432/dbname   # Postgres (ixtiyoriy, bo'sh bo'lsa orders.json)
ORDERS_FILE=orders.json       # DB bo'lmaganda buyurtmalar yoziladigan fayl
PORT=3000                     # sog'lomlik tekshiruvi (health) server porti
